{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@prevalentware/opencode-goal-plugin",
      {
        "auto_continue": false,
        "max_auto_turns": 25,
        "max_no_progress_turns": 5,
        "max_prompt_failures": 10
      }
    ],
    "opencode-background-agents",
    "opencode-token-tracker",
    "opencode-autotitle",
    "opencode-snip",
    "opencode-mystatus",
    "./vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode-go/glm-5.3-flash",
  "autoupdate": true,
  "share": "disabled",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "drawio": {
      "type": "local",
      "command": ["npx", "-y", "@drawio/mcp"],
      "enabled": true
    },
    "codex-connectors": {
      "type": "local",
      "command": ["npx", "-y", "@wileai/codex-connectors-mcp@0.2.0"],
      "enabled": true,
      "environment": {
        "CODEX_CONNECTORS_MODE": "compact",
        "CODEX_CONNECTORS_WRITES": "allow"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--extension"],
      "enabled": false
    }
  },
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    }
  },
  "permission": {
    "bash": {
      "git push": "ask",
      "git push *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean -f*": "ask",
      "gh repo delete": "ask",
      "gh repo delete *": "ask",
      "gh repo archive": "ask",
      "gh repo archive *": "ask",
      "gh release delete": "ask",
      "gh release delete *": "ask",
      "rm -rf": "ask",
      "rm -rf *": "ask",
      "rm -fr": "ask",
      "rm -fr *": "ask",
      "sudo": "ask",
      "sudo *": "ask"
    }
  }
}
