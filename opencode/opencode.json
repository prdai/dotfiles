{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@prevalentware/opencode-goal-plugin",
      {
        "auto_continue": false,
        "max_auto_turns": 25,
        "max_no_progress_turns": 5,
        "max_prompt_failures": 10
      }
    ],
    "opencode-background-agents",
    "opencode-token-tracker",
    "opencode-autotitle",
    "opencode-snip",
    "opencode-mystatus",
    "./vendor/i-have-adhd/.opencode/plugins/i-have-adhd.mjs"
  ],
  "model": "openai/gpt-5.6-luna",
  "small_model": "opencode-go/deepseek-v4-flash",
  "autoupdate": true,
  "share": "disabled",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    }
  },
  "permission": "allow"
}
