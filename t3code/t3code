#!/bin/sh
# T3 Code launcher.
#
# The AppImage needs libfuse.so.2, absent on this box, so run it extracted.
appimage="$HOME/Applications/t3code.AppImage"
window_class="com.t3tools.T3Code"

# Bail out if a live instance exists and focus its window instead. pgrep also
# matches zombie processes, so skip Z-state pids: a leftover corpse from a
# crash would otherwise block every future launch.
for pid in $(pgrep -x t3code); do
    state=$(ps -o stat= -p "$pid" 2>/dev/null)
    case "$state" in
        "" | Z*) continue ;;
    esac

    address=$(hyprctl clients -j 2>/dev/null | jq -r --arg class "$window_class" \
        '.[] | select(.class == $class) | .address' 2>/dev/null | head -n1)
    if [ -n "$address" ]; then
        hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
        exit 0
    fi
done

exec env APPIMAGE_EXTRACT_AND_RUN=1 "$appimage" --disable-gpu --no-sandbox "$@"
