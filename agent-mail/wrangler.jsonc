{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-mail",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
