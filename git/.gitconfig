[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
[credential]
        helper = store
[alias]
        wta = "!f() { git worktree add -b \"$1\" \"../$1\"; }; f"
        wtr = "!f() { git worktree remove \"../$1\"; }; f"
        wtl = "!f() { git worktree list; }; f"
[user]
	name = prdai
	email = prdai@users.noreply.github.com
[credential "https://github.com"]
	helper = 
	helper = !/home/prdai/.local/share/mise/installs/gh/2.98.0/gh_2.98.0_linux_amd64/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/prdai/.local/share/mise/installs/gh/2.98.0/gh_2.98.0_linux_amd64/bin/gh auth git-credential
