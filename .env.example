# Copy to .env in the repo root and fill in. .env is gitignored.
# NVIDIA hosted NIM (build.nvidia.com), OpenAI-compatible.
# Get a key at https://build.nvidia.com, then "Get API Key" on any model.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Self-hosted DearAgent inbox for agent@prdai.dev (see agents/skills/agent-email).
DEARAGENT_URL=https://dearagent.prdai.dev
DEARAGENT_API_KEY=da_your-key-here
